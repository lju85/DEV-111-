from typing import List

def min_search(arr:List[int]) -> int:
    """
    Функция для поиска минимума в массиве

    :param arr: Массив целых чисел
    :return: Индекс первого вхождения минимального элемента в массиве
    :raise: ValueError - если массив пуст
    """
    if not arr:
        raise ValueError("Массив не должен быть пустым")

    min_value = arr[0]
    min_index = 0

    for i in range(1, len(arr)):
        if arr[i] < min_value:
            min_value = arr[i]
            min_index = i

    return min_index
print(min_search([5, 2, 8, 2, 1]))
