from typing import Sequence

def sort(container: Sequence[int]) -> Sequence[int]:
    """
    Сортировка пузырьком

    1. Пройти по всему массиву, сравнивая каждые два соседних элемента.
    2. Если элементы не находятся в нужном порядке, меняйте их местами.
    3. Повторяйте шаг 2, пока не пройдете весь массив без изменений.
    4. Повторяйте шаги 1-3, пока не отсортируете весь массив.

    :param container: Массив, который надо отсортировать
    :return: Отсортированный в порядке возрастания массив
    """
    # Преобразуем входную последовательность в список, так как кортежи неизменяемы
    arr = list(container)
    n = len(arr)

    # Внешний цикл — количество проходов
    for i in range(n):
        swapped = False  # флаг для отслеживания обменов на текущем проходе

        # Внутренний цикл — проход по массиву до n - i - 1
        # (после каждого прохода самый большой элемент "всплывает" в конец)
        for j in range(0, n - i - 1):
            if arr[j] > arr[j + 1]:
                # Обмен элементов
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                swapped = True

        # Если ни одного обмена не было — массив уже отсортирован
        if not swapped:
            break

    # Возвращаем тот же тип, что и входной (если был кортеж — вернём кортеж)
    if isinstance(container, tuple):
        return tuple(arr)
    else:
        return arr

print(sort([6465, 34, 22125, 1154542, 12, 116, 9001]))
print(sort((5, 2, 8, 1)))
