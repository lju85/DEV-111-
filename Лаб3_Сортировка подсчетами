from typing import Sequence


def sort(container: Sequence[int]) -> Sequence[int]:
    """
    Сортировка подсчетами

    1. Определите максимальное значение в массиве и заполните вспомогательный массив с подсчетом количества элементов.
    2. Посчитайте количество каждого объекта
    3. Зная количество каждого объекта, восстановите отсортированный массив

    :param container: Массив, который надо отсортировать
    :return: Отсортированный в порядке возрастания массив
    """
    if not container:
        return container  # сохраняем тип (list, tuple и т.д.)

    max_val = max(container)
    # Создаём массив счётчиков от 0 до max_val включительно
    counts = [0] * (max_val + 1)

    # Подсчитываем частоту каждого числа
    for num in container:
        counts[num] += 1

    # Восстанавливаем отсортированный массив
    sorted_list = []
    for value in range(len(counts)):
        sorted_list.extend([value] * counts[value])

    # Сохраняем тип исходной последовательности
    if isinstance(container, tuple):
        return tuple(sorted_list)
    else:
        return sorted_list

print(sort([2,3,8,7,1,2,2,2,7,3,9,8,2,1,4,2,4,6,9,2]))
